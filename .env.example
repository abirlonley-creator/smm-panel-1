# ==============================================================================
# AuraSMM Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual production/staging values:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux/macOS)
# ==============================================================================

# 1. DATABASE CONFIGURATION
# SQLite (Default, file-based persistence on Windows RDP):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Optional alternative for remote cluster deployments):
# DATABASE_URL="postgresql://user:password@localhost:5432/aurasmm?schema=public"

# 2. APPLICATION & NETWORK CONFIGURATION
PORT=3000
NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="AuraSMM — Minimalist SMM Panel & Growth Planner"

# 3. PUBLIC WEBSITE & CORS CONFIGURATION
# If the frontend website is hosted on a different domain (e.g., Vercel, Netlify, Cloudflare Pages),
# set NEXT_PUBLIC_API_BASE_URL to your public backend URL (e.g., https://api.yourdomain.com).
# Leave empty or set to "" if the website frontend and backend are hosted on the same origin.
NEXT_PUBLIC_API_BASE_URL=""

# Allowed CORS origins for cross-domain requests (comma-separated or single domain)
ALLOWED_ORIGIN="https://yourdomain.com"

# 4. ADMINISTRATIVE AUTHENTICATION & SECURITY
# Bootstrap key used for first-time access key initialization via /api/admin/bootstrap
ADMIN_BOOTSTRAP_KEY="ReplaceWithAStrongMasterSecretKey123!"

# Secret salt used for HMAC signing of session tokens and access keys
ADMIN_SESSION_SECRET="ReplaceWithRandom64CharacterSecretSaltForHMACSigning2026!"

# 5. EXTERNAL SMM SERVICE PROVIDER API (Standard SMM API v2)
# Set to 'false' to enable live API communication with your SMM provider.
# If 'true' or if PROVIDER_API_KEY is empty, the built-in isolated sandbox mock adapter is used.
PROVIDER_IS_MOCK="true"

# Endpoint of the SMM Provider API (e.g., https://justanotherpanel.com/api/v2 or similar)
PROVIDER_API_URL="https://api.smmprovider.com/v2"

# Your secret API key provided in your provider's account dashboard.
# NEVER commit this key to version control or expose it to frontend JavaScript.
PROVIDER_API_KEY=""

# Provider balance refresh interval in milliseconds (default: 60000, range: 10000–3600000)
PROVIDER_BALANCE_REFRESH_INTERVAL_MS=60000

# 6. TIKTOK VIDEO ANALYTICS (Likes Analyze)
# Use 'apify' to read real public TikTok video counters with Clockworks' Apify Actor.
# Keep this token server-side; never expose it through a NEXT_PUBLIC_ variable.
# Set ANALYTICS_DATA_SOURCE='mock' only for sandbox simulation, or 'none' to disable metrics.
ANALYTICS_DATA_SOURCE="mock"
APIFY_API_TOKEN=""
# One single-video result per due checkpoint; limits help prevent unexpected run charges.
APIFY_REQUEST_TIMEOUT_MS=120000
APIFY_MAX_RUN_CHARGE_USD=0.5
# Maximum allowed difference between the selected interval and actual snapshot spacing.
LIKES_ANALYZE_INTERVAL_TOLERANCE_MS=60000
# Minimum-batch rule for Likes Analyze: controls what happens when the calculated batch
# quantity is below the provider minimum.
#   "clamp"  — lift the quantity to the provider minimum (default, recommended)
#   "skip"   — skip the interval entirely (original behaviour)
LIKES_ANALYZE_MINIMUM_BATCH_RULE=clamp

# 7. BACKGROUND WORKER & JOB SCHEDULER
# Interval in milliseconds between background worker ticks (processes due jobs and order sync)
WORKER_INTERVAL_MS=20000

# Concurrency limits and timeout settings
MAX_JOB_CONCURRENCY=5
PROVIDER_TIMEOUT_MS=15000
