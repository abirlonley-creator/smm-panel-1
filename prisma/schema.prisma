datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Provider {
  id              String          @id @default(cuid())
  name            String          // e.g. "Zeofame", "xmedia", "Standard SMM Provider"
  apiUrl          String
  apiKeyEncrypted String?         // AES-256-GCM encrypted
  isMock          Boolean         @default(false)
  active          Boolean         @default(true)
  currency        String          @default("USD")
  balance         Float?
  lastSyncAt      DateTime?
  services        Service[]
  orders          Order[]
  engagementRuns  EngagementRun[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Service {
  id                  String                  @id @default(cuid())
  externalId          String
  name                String
  type                String                  @default("Default")
  platform            String
  category            String
  description         String
  minQuantity         Int
  maxQuantity         Int
  ratePer1000         Float
  refillSupported     Boolean                 @default(false)
  cancelSupported     Boolean                 @default(true)
  dripFeedSupported   Boolean                 @default(false)
  dripFeedMinInterval Int                     @default(10)
  dripFeedMaxInterval Int                     @default(1440)
  restrictions        String?
  providerEndpoint    String?
  isMock              Boolean                 @default(false)
  active              Boolean                 @default(true)
  providerId          String?
  provider            Provider?               @relation(fields: [providerId], references: [id], onDelete: SetNull)
  userProviderId      String?
  userProvider        UserProviderConnection? @relation(fields: [userProviderId], references: [id], onDelete: Cascade)
  providerServiceId   String?
  favourites          Favourite[]
  orders              Order[]
  monitoringSessions  MonitoringSession[]
  comboItems          ComboItem[]
  engagementRuns      EngagementRun[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([providerEndpoint, active])
  @@index([externalId])
  @@index([providerId])
  @@index([userProviderId])
  @@unique([providerId, externalId])
  @@map("catalog_services")
}

model Order {
  id                String                  @id @default(cuid())
  orderRef          String                  @unique
  serviceId         String
  service           Service                 @relation(fields: [serviceId], references: [id])
  providerId        String?
  provider          Provider?               @relation(fields: [providerId], references: [id], onDelete: SetNull)
  targetUrl         String
  requestedQuantity Int
  submittedQuantity Int                     @default(0)
  deliveredQuantity Int                     @default(0)
  remainingQuantity Int                     @default(0)
  failedQuantity    Int                     @default(0)
  refundedAmount    Float                   @default(0)
  unitCost          Float
  totalCost         Float
  isScheduled       Boolean                 @default(false)
  scheduleMode      String?                 // "INSTANT", "EVEN_DRIP", "FRONT_LOADED", "GRADUAL_RAMP", "CUSTOM", "ADAPTIVE", "DRIP_FEED"
  status            String                  @default("PENDING") // DRAFT, SCHEDULED, PENDING, PROCESSING, PAUSED, COMPLETED, PARTIAL, FAILED, CANCELLED, REQUIRES_RECONCILIATION
  providerOrderId   String?
  refillId          String?
  refillStatus      String?
  errorMessage      String?
  notes             String?
  bulkBatchId       String?
  bulkBatch         BulkBatch?              @relation(fields: [bulkBatchId], references: [id], onDelete: SetNull)
  comboExecutionId  String?
  comboExecution    ComboExecution?         @relation(fields: [comboExecutionId], references: [id], onDelete: SetNull)
  scheduledJobId    String?
  scheduledJob      ScheduledOrderJob?      @relation(fields: [scheduledJobId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  steps             ScheduledDeliveryStep[]
  providerRecords   ProviderRequestRecord[]
  monitoringSession MonitoringSession?
  dripFeedRuns      DripFeedRun[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([userId])
  @@index([providerId])
}

model ScheduledDeliveryStep {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stepNumber     Int
  scheduledTime  DateTime
  quantity       Int
  status         String    @default("PENDING") // PENDING, PROCESSING, SUBMITTED, COMPLETED, FAILED, CANCELLED, PAUSED
  idempotencyKey String    @unique
  providerOrderId String?
  executedAt     DateTime?
  retryCount     Int       @default(0)
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ProviderRequestRecord {
  id              String   @id @default(cuid())
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stepId          String?
  action          String
  endpoint        String
  requestPayload  String
  responsePayload String
  statusCode      Int
  durationMs      Int
  success         Boolean
  createdAt       DateTime @default(now())
}

model User {
  id                 String                  @id @default(cuid())
  username           String                  @unique
  role               String                  @default("USER") // ADMIN | USER
  status             String                  @default("ACTIVE") // ACTIVE | DISABLED | REVOKED | EXPIRED
  walletBalance      Float                   @default(1000.0) // INR wallet balance
  passkeys           Passkey[]
  sessions           Session[]
  preferences        UserPreference?
  favourites         Favourite[]
  favouritesSnapshot FavouritesSnapshot?
  engagementMappings UserEngagementMapping[]
  providerConnections UserProviderConnection[]
  walletTransactions WalletTransaction[]
  orders             Order[]
  engagementOrders   EngagementOrder[]
  scheduledJobs      ScheduledOrderJob[]
  auditLogs          AuditLog[]
  monitoringSessions MonitoringSession[]
  combos             Combo[]
  comboExecutions    ComboExecution[]
  bulkBatches        BulkBatch[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  keyPrefix    String
  keyHash      String    @unique
  role         String    @default("USER") // ADMIN | USER
  status       String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED | DISABLED
  durationDays Int?
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, expiresAt])
}

model Session {
  id             String    @id @default(cuid())
  token          String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passkeyId      String?
  passkey        Passkey?  @relation(fields: [passkeyId], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([token, expiresAt])
}

model UserProviderConnection {
  id                 String                  @id @default(cuid())
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String                  // e.g. "Zeofame", "xmedia"
  apiUrl             String
  apiKeyEncrypted    String?                 // AES-256-GCM encrypted
  isMock             Boolean                 @default(false)
  active             Boolean                 @default(true)
  balance            Float?
  currency           String                  @default("USD")
  servicesCount      Int                     @default(0)
  lastSyncAt         DateTime?
  lastError          String?
  services           Service[]
  engagementMappings UserEngagementMapping[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([userId, name])
  @@index([userId, active])
  @@map("user_providers")
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  onlyFavourites   Boolean  @default(false)
  activeProviderId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user_preferences")
}

model Favourite {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId        String
  providerServiceId String
  serviceId         String?
  service           Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([userId, providerId, providerServiceId])
  @@index([userId])
  @@map("favourites")
}

model FavouritesSnapshot {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceKeys  String   @default("[]") // JSON string array of "providerId:providerServiceId"
  serviceCount Int      @default(0)
  confirmedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("favourites_snapshot")
}

model UserEngagementMapping {
  id                String                 @id @default(cuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          String                 // "Instagram", "TikTok"
  engagementType    String                 // "views", "likes", "shares", "saves", "comments"
  providerId        String
  provider          UserProviderConnection @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerServiceId String
  serviceName       String?
  minQuantity       Int                    @default(10)
  maxQuantity       Int                    @default(100000)
  ratePer1000       Float                  @default(0)
  active            Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([userId, platform, engagementType])
  @@index([userId])
  @@index([providerId])
  @@map("engagement_mappings")
}

model WalletTransaction {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String    // "CREDIT" | "DEBIT" | "REFUND" | "RESERVATION"
  amount       Float     // in INR
  balanceAfter Float
  referenceId  String?   // orderRef, runId, or rechargeRef
  description  String
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
}

model WorkerStatus {
  id              String    @id @default("singleton")
  lastHeartbeatAt DateTime  @default(now())
  status          String    @default("RUNNING") // RUNNING, STOPPED, DEGRADED
  activeWorkers   Int       @default(1)
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

model AccessKey {
  id         String    @id @default(cuid())
  label      String
  keyPrefix  String
  keyHash    String    @unique
  role       String    @default("ADMIN")
  status     String    @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String
  details   String
  ipAddress String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// =====================================================================
// Likes Analyze — persistent interval-based video monitoring sessions
// =====================================================================

model MonitoringSession {
  id                   String                 @id @default(cuid())
  orderRef             String                 @unique
  serviceId            String
  service              Service                @relation(fields: [serviceId], references: [id])
  orderId              String?                @unique
  order                Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  videoUrl             String
  videoIdentifier      String                 @default("")
  durationMinutes      Int
  intervalMinutes      Int
  budgetCap            Float
  quantityCap          Int
  status               String                 @default("RUNNING") // RUNNING, PAUSED, STOPPED, EXPIRED, COMPLETED
  analyticsSource      String                 @default("MOCK_ANALYTICS")
  startedAt            DateTime
  expiresAt            DateTime
  lastCheckpointAt     DateTime?
  nextCheckpointAt     DateTime?
  // Float (double): video engagement counts exceed the 32-bit Int range.
  initialLikes         Float?
  initialViews         Float?
  latestSnapshotId     String?
  snapshotCount        Int                    @default(0)
  missedCheckpoints    Int                    @default(0)
  scheduleReviserCount Int                    @default(0)
  stopNote             String?
  snapshots            VideoSnapshot[]
  checkpoints          MonitoringCheckpoint[]
  events               MonitoringAuditEvent[]
  userId               String?
  user                 User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([status, nextCheckpointAt])
  @@index([userId])
}

model MonitoringCheckpoint {
  id           String            @id @default(cuid())
  sessionId    String
  session      MonitoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence     Int
  plannedAt    DateTime
  executedAt   DateTime?
  delayMs      Int?
  status       String            @default("PENDING") // PENDING, EXECUTED, MISSED, SKIPPED, EXPIRED, PAUSED
  retryCount   Int               @default(0)
  errorMessage String?
  snapshot     VideoSnapshot?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Guarantees one checkpoint per sequence per session (duplicate-worker safety)
  @@unique([sessionId, sequence])
  @@index([sessionId, status])
}

model VideoSnapshot {
  id              String                 @id @default(cuid())
  sessionId       String
  session         MonitoringSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  checkpointId    String                @unique
  checkpoint      MonitoringCheckpoint  @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  sequence        Int
  plannedAt       DateTime
  executedAt      DateTime
  delayMs         Int                    @default(0)
  // Counters use Float (double precision): real video view counts exceed the
  // 32-bit Int range (e.g. > 2.1B views) and must be representable exactly.
  likes           Float?
  views           Float?
  likesDelta      Float?
  viewsDelta      Float?
  ratio           Float?                 // observed like/view ratio, only when views > 0
  source          String                 @default("")
  isFresh         Boolean                @default(true)
  reliabilityNote String?
  createdAt       DateTime               @default(now())

  // Idempotency: one snapshot per session checkpoint sequence
  @@unique([sessionId, sequence])
  @@index([sessionId, executedAt])
}

model MonitoringAuditEvent {
  id         String            @id @default(cuid())
  sessionId  String
  session    MonitoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  action     String
  details    String
  createdAt  DateTime          @default(now())

  @@index([sessionId, createdAt])
}

// =====================================================================
// New Order Enhancements: Bulk Add, Combo Maker & Persistent Scheduler
// =====================================================================

model BulkBatch {
  id              String      @id @default(cuid())
  batchRef        String      @unique // e.g. "BLK-102938"
  status          String      @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, PARTIAL, FAILED
  totalOrders     Int
  successOrders   Int         @default(0)
  failedOrders    Int         @default(0)
  totalCost       Float       @default(0)
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders          Order[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
}

model Combo {
  id              String           @id @default(cuid())
  comboRef        String           @unique // e.g. "CMB-102938"
  name            String
  description     String?
  active          Boolean          @default(true)
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           ComboItem[]
  executions      ComboExecution[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
}

model ComboItem {
  id              String      @id @default(cuid())
  comboId         String
  combo           Combo       @relation(fields: [comboId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id])
  defaultQuantity Int
  targetType      String      @default("SAME_URL") // "SAME_URL" or "CUSTOM_URL"
  customUrl       String?
  orderIndex      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model ComboExecution {
  id                 String      @id @default(cuid())
  executionRef       String      @unique // e.g. "CMBX-102938"
  comboId            String
  combo              Combo       @relation(fields: [comboId], references: [id], onDelete: Cascade)
  targetUrl          String
  status             String      @default("PENDING") // PENDING, PROCESSING, COMPLETED, PARTIAL, FAILED, CANCELLED
  totalCost          Float       @default(0)
  totalServices      Int         @default(0)
  successfulServices Int         @default(0)
  failedServices     Int         @default(0)
  errorMessage       String?
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders             Order[]
  createdAt          DateTime    @default(now())
  completedAt        DateTime?
  updatedAt          DateTime    @updatedAt

  @@index([userId])
}

model ScheduledOrderJob {
  id             String      @id @default(cuid())
  jobRef         String      @unique // e.g. "SCH-102938"
  jobType        String      // "SINGLE", "BULK", "COMBO"
  status         String      @default("SCHEDULED") // DRAFT, SCHEDULED, QUEUED, PROCESSING, SUBMITTED, COMPLETED, PARTIAL, FAILED, CANCELLED, PAUSED
  scheduledFor   DateTime    // UTC timestamp of planned execution
  timezone       String      @default("UTC")
  payload        String      // JSON encoded configuration of the order / batch / combo
  resultPayload  String?     // JSON encoded results
  retryCount     Int         @default(0)
  maxRetries     Int         @default(3)
  errorMessage   String?
  executedAt     DateTime?
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders         Order[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, scheduledFor])
  @@index([userId])
}

// =====================================================================
// Full Engagement (Organic S-Curve Delivery)
// =====================================================================

model EngagementOrder {
  id                String          @id @default(cuid())
  orderRef          String          @unique // e.g. "ENG-102938"
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetUrl         String
  platform          String          // "Instagram" | "TikTok"
  profileId         String?         // "instagram_reel" | "instagram_post" | "tiktok"
  presetKey         String?         // "fast" | "normal" | "slow"
  baseViews         Int
  durationHours     Int             @default(24)
  seed              String          // Mulberry32 seed for 100% reproducible curves
  status            String          @default("PROCESSING") // PENDING, PROCESSING, COMPLETED, PARTIAL, FAILED, CANCELLED
  totalCost         Float           @default(0)
  refundedAmount    Float           @default(0)
  plannedViews      Int             @default(0)
  plannedLikes      Int             @default(0)
  plannedShares     Int             @default(0)
  plannedSaves      Int             @default(0)
  plannedComments   Int             @default(0)
  viewsSource       String          @default("suggested") // "suggested" | "custom"
  likesSource       String          @default("suggested")
  savesSource       String          @default("suggested")
  sharesSource      String          @default("suggested")
  commentsSource    String          @default("suggested")
  enabledTypes      String?         // JSON string array of enabled types
  deliveredViews    Int             @default(0)
  deliveredLikes    Int             @default(0)
  deliveredShares   Int             @default(0)
  deliveredSaves    Int             @default(0)
  deliveredComments Int             @default(0)
  planParams        String?         // Stored JSON configuration for deterministic reproduction
  expectedCurve     String?         // Stored JSON of 100 curve points sampled across total duration
  statusSamples     String?         // Stored JSON array of actual delivered cumulative status samples over time
  deviationStatus   String          @default("on_track") // "on_track" | "slightly_behind" | "behind" | "ahead"
  typeStatuses      String?         // Stored JSON record of deviation status per type
  replanCount       Int             @default(0)
  lastReplanReason  String?
  behindSince       DateTime?
  runs              EngagementRun[]
  eventLogs         OrderEventLog[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model EngagementRun {
  id                String          @id @default(cuid())
  engagementOrderId String
  engagementOrder   EngagementOrder @relation(fields: [engagementOrderId], references: [id], onDelete: Cascade)
  engagementType    String          // "views" | "likes" | "shares" | "saves" | "comments"
  serviceId         String?
  service           Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  providerId        String?
  provider          Provider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerServiceId String?         // Provider's own numeric ID
  runNumber         Int?            // Sequence index
  scheduledAt       DateTime
  quantity          Int
  plannedCumulative Int?            // Expected cumulative delivered at this run
  deliveredQuantity Int?            // Confirmed quantity delivered
  deliveredCumulative Int?          // Confirmed cumulative delivered
  claimedAt         DateTime?
  sentAt            DateTime?       // Actual send timestamp
  confirmedAt       DateTime?       // Delivery confirmation timestamp
  timeToStartMs     Int?            // Milliseconds from scheduled to sent
  timeToConfirmMs   Int?            // Milliseconds from sent to confirmed
  isReplan          Boolean         @default(false)
  status            String          @default("scheduled") // scheduled, claimed, sending, sent, confirmed, delayed, failed, cancelled
  providerOrderId   String?
  idempotencyKey    String?         @unique
  attempts          Int             @default(0)
  lastAttemptAt     DateTime?
  latenessSeconds   Int?
  errorType         String?         // timeout, invalid_key, insufficient_funds, service_not_found, rate_limit, link_rejected, dns_tls, unknown
  httpStatus        Int?
  errorMessage      String?
  rawResponse       String?         // Sanitized (secrets removed)
  cost              Float           @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, scheduledAt])
  @@index([engagementOrderId, engagementType])
  @@index([providerId, providerServiceId])
  @@map("runs")
}

model AdminAlert {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  severity        String    // "high" | "medium" | "low"
  type            String    // "provider_down" | "invalid_api_key" | "service_not_found" | "insufficient_balance" | "run_failed" | "run_late" | "order_refunded" | "replan" | "ahead" | "watchdog_stuck" | "watchdog_heartbeat"
  orderId         String?
  runId           String?
  runNumber       Int?
  userId          String?
  platform        String?
  engagementType  String?   // "views" | "likes" | "saves" | "shares" | "comments"
  providerId      String?
  providerName    String?
  serviceId       String?
  planned         Int?
  delivered       Int?
  deviationPercent Float?
  errorType       String?   // timeout, invalid_key, insufficient_funds, etc.
  dedupKey        String?   // Grouping key for alert deduplication
  dedupCount      Int       @default(1)
  lastSeenAt      DateTime?
  reason          String    // Plain-language reason
  rawResponse     String?   // Sanitized (secrets removed)
  retryCount      Int       @default(0)
  status          String    @default("open") // "open" | "retrying" | "resolved"
  actionTaken     String?
  suggestedAction String?   // Plain-language suggested admin action
  resolvedBy      String?
  resolvedAt      DateTime?

  @@index([status, severity])
  @@index([createdAt])
  @@index([providerId])
  @@index([dedupKey])
  @@map("alerts")
}

model OrderEventLog {
  id                String          @id @default(cuid())
  engagementOrderId String
  engagementOrder   EngagementOrder @relation(fields: [engagementOrderId], references: [id], onDelete: Cascade)
  runId             String?
  eventType         String          // "STATE_CHANGE" | "PROVIDER_CALL" | "REPLAN" | "WATCHDOG" | "REFUND"
  message           String
  requestSummary    String?
  responseCode      Int?
  rawResponse       String?         // Sanitized (secrets removed)
  durationMs        Int?
  metadata          String?         // JSON
  createdAt         DateTime        @default(now())

  @@index([engagementOrderId, createdAt])
  @@index([eventType])
  @@map("order_event_logs")
}

// =====================================================================
// Drip Feed Random Range Runs
// =====================================================================

model DripFeedRun {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runNumber       Int
  scheduledAt     DateTime
  quantity        Int
  status          String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  providerOrderId String?
  attempts        Int       @default(0)
  errorMessage    String?
  cost            Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([orderId])
}
